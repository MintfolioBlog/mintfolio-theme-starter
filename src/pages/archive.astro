---
import type { ListPageData, PageProps } from '@mintfolio/core/astro';
import PostArchive from '@mintfolio/core/components/PostArchive.astro';
import type { StarterSettings } from '../settings';
import StarterLayout from '../layouts/StarterLayout.astro';
interface Props extends PageProps<StarterSettings, ListPageData> {}
const { theme, page } = Astro.props;
const [tags, categories, series] = await Promise.all([
  theme.taxonomy.tags(), theme.taxonomy.categories(), theme.taxonomy.series(),
]);
---
<StarterLayout theme={theme} page={page}>
  <header><h1>{page.title}</h1><p>{page.description}</p></header>
  {series.length > 0 && <nav class="term-links" aria-label="文章系列">
    <span>系列：</span>
    {series.map((term) => <a href={term.url} aria-current={page.taxonomy?.kind === 'series' && page.taxonomy.label === term.label ? 'page' : undefined}>{term.label} ({term.count})</a>)}
  </nav>}
  <PostArchive posts={page.posts} tags={tags} categories={categories} filters={page.filters}
    pagination={page.pagination} archiveUrl={theme.urls.archive()} language={theme.site.language} />
</StarterLayout>
