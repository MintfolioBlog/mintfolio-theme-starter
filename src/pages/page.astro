---
import type { PageProps, StaticPageData } from '@mintfolio/core/astro';
import Image from '@mintfolio/core/components/Image.astro';
import type { StarterSettings } from '../settings';
import StarterLayout from '../layouts/StarterLayout.astro';
interface Props extends PageProps<StarterSettings, StaticPageData> {}
const { theme, page } = Astro.props;
---
<StarterLayout theme={theme} page={page}>
  <article>
    <header>
      <h1>{page.title}</h1><p>{page.description}</p>
      {page.preview && <p class="status-label">草稿预览</p>}
    </header>
    {page.body ? <div class="starter-prose" set:html={page.body.html} /> : page.id === 'about' && (
      <div class="starter-prose">
        {page.profile.avatar && <Image src={page.profile.avatar} alt={page.profile.name + '的头像'} width={120} height={120} />}
        <p>{page.profile.bio}</p>
        <dl>
          <dt>姓名</dt><dd>{page.profile.name}</dd>
          {page.profile.location && <><dt>所在地</dt><dd>{page.profile.location}</dd></>}
          {theme.site.contact.email && <><dt>联系方式</dt><dd><a href={'mailto:' + theme.site.contact.email}>{theme.site.contact.email}</a></dd></>}
        </dl>
        {page.profile.signature && <p>{page.profile.signature}</p>}
        {theme.site.social.length > 0 && <nav class="term-links" aria-label="社交链接">{theme.site.social.map((social) => <a href={social.url} rel="me">{social.platform}</a>)}</nav>}
        {theme.site.projects.length > 0 && <section aria-labelledby="projects-heading">
          <h2 id="projects-heading">项目</h2>
          <ul class="post-list">{theme.site.projects.map((project) => <li>
            <h3>{project.title}</h3><p>{project.description}</p>
            {project.link && <a href={project.link}>访问项目</a>}
            {project.link && project.repo && ' · '}
            {project.repo && <a href={project.repo}>源码</a>}
          </li>)}</ul>
        </section>}
      </div>
    )}
  </article>
</StarterLayout>
