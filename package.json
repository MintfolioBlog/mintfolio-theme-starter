{
  "name": "theme-mintfolio-starter",
  "version": "0.4.3",
  "type": "module",
  "files": [
    "theme.mjs",
    "src/assets",
    "src/pages",
    "src/layouts",
    "src/styles",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "src/settings.ts",
    "src/config"
  ],
  "exports": {
    "./theme": "./theme.mjs",
    "./settings": "./src/settings.ts",
    "./config": "./src/config/theme-starter.config.mjs"
  },
  "peerDependencies": {
    "astro": "^7.3.2",
    "@mintfolio/core": "^0.4.4"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@astrojs/check": "^0.9.10",
    "@mintfolio/core": "^0.4.4",
    "astro": "^7.3.2",
    "@types/node": "^22.20.2"
  },
  "scripts": {
    "check": "astro check && node node_modules/@typescript/native/bin/tsc --noEmit",
    "prepack": "npm run check",
    "deps:update": "node tools/update-local-deps.mjs",
    "demo:setup": "node tools/demo.mjs setup",
    "demo": "node tools/demo.mjs dev",
    "demo:build": "node tools/demo.mjs build",
    "demo:preview": "node tools/demo.mjs preview"
  },
  "description": "A compact Mintfolio theme template with four renderers and Core-owned content services.",
  "license": "GPL-3.0-only",
  "author": "CNFLWZH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MintfolioBlog/mintfolio-theme-starter.git"
  },
  "homepage": "https://github.com/MintfolioBlog/mintfolio-theme-starter#readme",
  "bugs": {
    "url": "https://github.com/MintfolioBlog/mintfolio-theme-starter/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "mintfolio": {
    "configTemplate": "./src/config/theme-starter.config.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
