{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.astro",
    "**/*.ts",
    "**/*.tsx",
    "theme.mjs"
  ],
  "exclude": [
    "node_modules",
    ".cache",
    "dist",
    "vendor",
    ".preview",
    "examples"
  ]
}
